  {
   "type": "stat",
   "title": "Hours since last good run",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "id": 2,
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "(time() - max(mail_backup_last_success_timestamp_seconds)) / 3600",
     "legendFormat": "",
     "refId": "D"
    }
   ],
   "options": {
    "colorMode": "background",
    "graphMode": "area",
    "justifyMode": "center",
    "textMode": "auto",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "h",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 26
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     },
     "mappings": [],
     "decimals": 1
    },
    "overrides": []
   }
  },
