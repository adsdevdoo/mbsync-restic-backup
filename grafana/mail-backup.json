{
 "uid": "mail-backup",
 "title": "Mail backup",
 "tags": [
  "backup",
  "mail"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "graphTooltip": 1,
 "refresh": "30s",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "datasource",
    "label": "Prometheus",
    "type": "datasource",
    "query": "prometheus",
    "refresh": 1,
    "current": {}
   }
  ]
 },
 "annotations": {
  "list": []
 },
 "panels": [
  {
   "type": "row",
   "title": "State",
   "id": 1,
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "type": "stat",
   "title": "Backup",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "id": 2,
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "(((max(mail_backup_run_started_timestamp_seconds) > (max(mail_backup_run_finished_timestamp_seconds) or vector(0))) and (time() - max(mail_backup_run_started_timestamp_seconds) < 12 * 3600)) * 0 + 1) or vector(0)",
     "legendFormat": "",
     "refId": "D"
    }
   ],
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "justifyMode": "center",
    "textMode": "auto",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "text",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     },
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "idle"
        },
        "1": {
         "text": "running"
        }
       }
      }
     ]
    },
    "overrides": []
   }
  },
  {
   "type": "stat",
   "title": "Run time (running, else last good)",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "id": 4,
   "gridPos": {
    "x": 4,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "((time() - max(mail_backup_run_started_timestamp_seconds)) and ((max(mail_backup_run_started_timestamp_seconds) > (max(mail_backup_run_finished_timestamp_seconds) or vector(0))) and (time() - max(mail_backup_run_started_timestamp_seconds) < 12 * 3600))) or max(mail_backup_last_duration_seconds)",
     "legendFormat": "",
     "refId": "F"
    }
   ],
   "options": {
    "colorMode": "value",
    "graphMode": "none",
    "justifyMode": "center",
    "textMode": "auto",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "dtdurations",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "text",
        "value": null
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     },
     "mappings": [],
     "noValue": "never"
    },
    "overrides": []
   }
  },
  {
