  {
   "type": "table",
   "title": "Folders",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "id": 36,
   "gridPos": {
    "x": 0,
    "y": 15,
    "w": 24,
    "h": 12
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "max by (folder) (mail_backup_folder_server_messages)",
     "legendFormat": "",
     "refId": "A",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "max by (folder) (mail_backup_folder_letters)",
     "legendFormat": "",
     "refId": "B",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "clamp_min(max by (folder) (mail_backup_folder_server_messages) - max by (folder) (mail_backup_folder_letters), 0)",
     "legendFormat": "",
     "refId": "C",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "max by (folder) (mail_backup_folder_refused)",
     "legendFormat": "",
     "refId": "D",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "max by (folder) (mail_backup_folder_parked)",
     "legendFormat": "",
     "refId": "E",
     "instant": true,
     "range": false,
     "format": "table"
    }
   ],
   "transformations": [
    {
     "id": "merge",
     "options": {}
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true
      },
      "indexByName": {
       "folder": 0,
       "Value #A": 1,
       "Value #B": 2,
       "Value #C": 3,
       "Value #D": 4,
       "Value #E": 5
      },
      "renameByName": {
       "folder": "Folder",
       "Value #A": "On the server",
       "Value #B": "Here",
       "Value #C": "Not downloaded",
       "Value #D": "Refused",
       "Value #E": "Parked"
      }
     }
    }
   ],
   "options": {
    "showHeader": true,
    "cellHeight": "sm",
    "sortBy": [
     {
      "displayName": "Not downloaded",
      "desc": true
     }
    ]
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "align": "auto",
      "cellOptions": {
       "type": "auto"
      }
     },
     "unit": "locale"
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Not downloaded"
      },
      "properties": [
       {
        "id": "thresholds",
        "value": {
         "mode": "absolute",
         "steps": [
          {
           "color": "green",
           "value": null
          },
          {
           "color": "yellow",
           "value": 1
          }
         ]
        }
       },
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-text"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Refused"
      },
      "properties": [
       {
        "id": "thresholds",
        "value": {
         "mode": "absolute",
         "steps": [
          {
           "color": "text",
           "value": null
          },
          {
           "color": "yellow",
           "value": 1
          }
         ]
        }
       },
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-text"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Parked"
      },
      "properties": [
       {
        "id": "unit",
        "value": "short"
       },
       {
        "id": "mappings",
        "value": [
         {
          "type": "value",
          "options": {
           "0": {
            "text": ""
           },
           "1": {
            "text": "parked",
            "color": "orange"
           }
          }
         }
        ]
       },
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-text"
        }
       }
      ]
     }
    ]
   }
  },
  {
   "type": "row",
   "title": "Trends",
   "id": 42,
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 27,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "type": "timeseries",
   "title": "Letters",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "id": 44,
   "gridPos": {
    "x": 0,
    "y": 28,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "max(mail_backup_letters)",
     "legendFormat": "letters",
     "refId": "R"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max",
      "mean"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "locale",
     "color": {
      "mode": "palette-classic"
     },
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 10,
      "gradientMode": "opacity",
      "showPoints": "never",
      "spanNulls": true,
      "stacking": {
       "mode": "none",
       "group": "A"
      },
      "thresholdsStyle": {
       "mode": "off"
      }
     }
    },
    "overrides": []
   }
  },
  {
   "type": "timeseries",
   "title": "Letters per minute",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "id": 46,
   "gridPos": {
    "x": 12,
    "y": 28,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "clamp_min(deriv(max(mail_backup_letters)[15m:1m]) * 60, 0)",
     "legendFormat": "letters/min",
     "refId": "T"
