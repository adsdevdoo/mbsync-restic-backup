# Host directory for the Maildir, the restic repository and the script state. Must exist.
DATA_DIR=/srv/mail-backup

# Image to run. Default: ghcr.io/adsdevdoo/mbsync-restic-backup:latest. Pin a commit for a deployment that changes
# only when you decide (ghcr.io/adsdevdoo/mbsync-restic-backup:<full commit SHA>), or use your own build
# (docker build -t mbsync-restic-backup:local .).
# IMAGE=

# Mailbox. The password is the file secrets/imap_password (for Yandex 360: an app password).
IMAP_HOST=imap.yandex.ru
IMAP_PORT=993
IMAP_USER=user@example.com

# Cron schedule and its time zone.
SCHEDULE=30 4 * * *
TZ=UTC

# Snapshot retention.
KEEP_DAILY=30
KEEP_WEEKLY=8
KEEP_MONTHLY=24
# restic check on this weekday (1 = Monday, 7 = Sunday; empty = never), reading this share of the data.
CHECK_WEEKDAY=7
CHECK_READ_SUBSET=10%

# mbsync sessions at the same time, each on its own share of the folders (1-8). Mind the server's limit on
# simultaneous IMAP connections; start with 2.
PARALLEL=1
# While mbsync runs, write letters and sizes every N seconds for a live dashboard (0 = after each attempt only).
PROGRESS_INTERVAL=60
# Commands mbsync keeps in flight, and mbsync restarts per run after a dropped connection.
PIPELINE_DEPTH=8
MBSYNC_ATTEMPTS=3

# Which error answers to a letter fetch count as a refused letter (extended regex; empty = any).
# Yandex 360: \[UNAVAILABLE\]
REFUSED_PATTERN=
# More refused letters than this in one attempt fail the run; 0 = no limit.
REFUSED_MAX=1000
# Extra mbsync patterns, e.g. for Gmail: !"[Gmail]/All Mail"
EXTRA_PATTERNS=

# Parking a folder the server keeps refusing letters in (see README). NEVER_PARK: space-separated.
PARK_FAILURES=300
PARK_RATIO=2
# Stalled attempts in a row before parking: 2 (wait for a confirmation) or 1 (at once; faster on a big outage).
PARK_AFTER=2
NEVER_PARK=INBOX Sent Drafts

# Optional off-host copy of the restic repository, rsync over SSH. Empty = off. user@host:path, colon required.
# Key: secrets/copy_ssh_key, host key: secrets/copy_known_hosts.
COPY_TARGET=
# COPY_TARGET=backup@backup-host.example:
COPY_PORT=22
